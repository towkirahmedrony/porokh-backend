# ParaPoth backend configuration.
#
# Copy to .env and fill in real values locally. Never commit .env.

# Runtime
NODE_ENV=development
PORT=5000

# Comma-separated list of additional allowed browser origins. The built-in
# Firebase Hosting origins are always allowed in production.
CLIENT_URL=http://localhost:5173

# Supabase (service role is used only on the server)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exam submission grace window in milliseconds.
#
# A submission that arrives shortly after `deadline_at` is still accepted while
# the automatic client submit at timer zero is in flight. Defaults to 30000
# (30 seconds) when unset or invalid. Values above 600000 are ignored.
EXAM_SUBMIT_GRACE_MS=30000

# Shared secret for POST /api/v1/internal/cron/groups-tick.
#
# The endpoint runs refresh_group_leaderboard() and
# finalize_due_group_battles(); callers must send it as `x-cron-secret` (or a
# Bearer token). Leave empty to disable the endpoint.
CRON_SECRET=

# Firebase Admin (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
SMTP_EMAIL=
SMTP_PASSWORD=

# Gemini text generation for the student AI Assistant (tutor chat and
# explanations), on the assistant's own Google Cloud project. Server-side only.
# Question extraction does NOT use this key (see EXTRACTION_GEMINI_API_KEY).
GEMINI_API_KEY=

# AI embeddings
GEMINI_EMBEDDING_API_KEY=

# AI Question Importer extraction (Google Gemini on its OWN Google Cloud
# project and API key, so importer traffic never spends the student AI
# Assistant's Gemini project or quota). The extraction code path reads these two
# variables only and never falls back to GEMINI_API_KEY.
#
# Create a key from a second Google Cloud project in Google AI Studio.
# Leave EXTRACTION_GEMINI_MODEL empty for the default,
# gemini-3.8-flash (free-tier, vision-capable). gemini-3.5-flash-lite is the
# cheaper free-tier alternative for high-volume drafts.
EXTRACTION_GEMINI_API_KEY=
EXTRACTION_GEMINI_MODEL=

# Optional integrations
GOOGLE_SCRIPT_URL=
ADMIN_TOTP_SECRET=
